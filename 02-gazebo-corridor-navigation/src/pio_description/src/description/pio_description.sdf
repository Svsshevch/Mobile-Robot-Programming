<?xml version="1.0" ?>

<sdf version="1.8">
  <model name="pio_robot">

    <static>false</static>

    <!-- +x = forward +y = left +z = up-->

    <link name="base_link">

      <pose>0 0 0.1 0 0 0</pose>

      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.015</iyy>
          <iyz>0.0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.35 0.25 0.10</size>
          </box>
        </geometry>
        <material>
            <ambient>0.996 0.404 0.592 1</ambient>
            <diffuse>0.996 0.404 0.592 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.35 0.25 0.10</size>
          </box>
        </geometry>
      </collision>

    </link>


    <link name="left_wheel">

      <pose relative_to="base_link">-0.1 0.145 -0.05 1.5708 0 0</pose>

      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0002</iyy>
          <iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

      <visual name="left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.996 0.514 0.404 1</ambient>
          <diffuse>0.996 0.514 0.404 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <collision name="left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>


    <link name="right_wheel">

      <pose relative_to="base_link">-0.1 -0.145 -0.05 1.5708 0 0</pose>

      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0002</iyy>
          <iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

      <visual name="right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.996 0.514 0.404 1</ambient>
          <diffuse>0.996 0.514 0.404 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <collision name="right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>


    <link name="caster_wheel">

      <pose relative_to="base_link"> 0.12 0 -0.05 0 0 0</pose>

      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0.0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>

      <visual name="caster_visual">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.996 0.808 0.404 1</ambient>
          <diffuse>0.996 0.808 0.404 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <collision name="caster_collision">
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>

    <link name="lidar_link">

      <pose relative_to="base_link">-0.04 0 0.0675 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.404 0.592 0.996 1</ambient>
          <diffuse>0.404 0.592 0.996 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>

        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.10</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>

        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="base_link">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_wheel</child>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
    <link name="rgb_camera_link">
      <pose relative_to="base_link">0.2 0 0 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

      <visual name="rgb_camera_visual">
        <geometry>
          <box>
            <size>0.05 0.04 0.04</size>
          </box>
        </geometry>
        <material>
            <ambient>0.404 0.996 0.808 1</ambient>
            <diffuse>0.404 0.996 0.808 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <collision name="rgb_camera_collision">
        <geometry>
          <box>
            <size>0.05 0.04 0.04</size>
          </box>
        </geometry>
      </collision>

      <sensor name="rgb_camera_sensor" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>/camera/image_raw</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="rgb_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>rgb_camera_link</child>
    </joint>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.28</wheel_separation>
      <wheel_radius>0.05</wheel_radius>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>

      <topic>/mrp/cmd_vel</topic>
      <odom_topic>/mrp/odom</odom_topic>

      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <topic>joint_states</topic>

    </plugin>

  </model>
</sdf>
